# Copy to .env, fill it in, then `make`.

# The name that points at this machine. The page needs https: an insecure page gets no folder access.
DOMAIN=draft.example.com

# Where Let's Encrypt sends expiry warnings.
EMAIL=you@example.com

# The whole site sits behind this login.
BASIC_USER=me
BASIC_PASS=change-me

# Set to 1 to ask the Let's Encrypt staging service while testing a new domain.
STAGING=0

# Log level of the app. w2b_web=debug,w2b_core=debug says a great deal more.
RUST_LOG=w2b_web=info,w2b_core=info
